{
  "apiVersion": "apps.openshift.io/v1",
  "kind": "DeploymentConfig",
  "metadata": {
    "name": "web",
    "namespace": "example",
    "annotations": {
      "fixture.openshift-dc.io/provenance": "synthetic; no cluster result",
      "fixture.openshift-dc.io/target": "4.18"
    }
  },
  "spec": {
    "replicas": 1,
    "paused": false,
    "minReadySeconds": 7,
    "revisionHistoryLimit": 0,
    "selector": {
      "deploymentconfig": "web",
      "app": "web"
    },
    "strategy": {
      "type": "Recreate"
    },
    "triggers": [
      {
        "type": "ConfigChange"
      }
    ],
    "template": {
      "metadata": {
        "labels": {
          "deploymentconfig": "web",
          "app": "web",
          "service-label": "retain"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "web",
            "image": "registry.example/web:v1",
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "env": [
              {
                "name": "CONFIG",
                "valueFrom": {
                  "configMapKeyRef": {
                    "name": "web-config",
                    "key": "config"
                  }
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "32Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "scratch",
                "mountPath": "/tmp/scratch"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "scratch",
            "emptyDir": {}
          }
        ]
      }
    }
  }
}